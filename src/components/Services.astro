---
// Σελίδα Υπηρεσίες - 7 πυλώνες με υποστοιχεία (κοινό σώμα EL/EN, γλώσσα από currentLocale).
// Περιεχόμενο από τα masters (_source), πυλώνες 2.1-2.7. Reuse s1..s7 + νέα svc.* bullets.
import { useTranslations, type Lang, type UiKey } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'el') as Lang;
const t = useTranslations(lang);

const pillars: { no: string; t: UiKey; d: UiKey; li: UiKey[] }[] = [
  { no: '01', t: 's1.t', d: 's1.d', li: ['svc.p1.1', 'svc.p1.2', 'svc.p1.3'] },
  { no: '02', t: 's2.t', d: 's2.d', li: ['svc.p2.1', 'svc.p2.2', 'svc.p2.3'] },
  { no: '03', t: 's3.t', d: 's3.d', li: ['svc.p3.1', 'svc.p3.2', 'svc.p3.3'] },
  { no: '04', t: 's4.t', d: 's4.d', li: ['svc.p4.1', 'svc.p4.2', 'svc.p4.3', 'svc.p4.4'] },
  { no: '05', t: 's5.t', d: 's5.d', li: ['svc.p5.1', 'svc.p5.2', 'svc.p5.3', 'svc.p5.4', 'svc.p5.5'] },
  { no: '06', t: 's6.t', d: 's6.d', li: ['svc.p6.1', 'svc.p6.2', 'svc.p6.3'] },
  { no: '07', t: 's7.t', d: 's7.d', li: ['svc.p7.1', 'svc.p7.2', 'svc.p7.3', 'svc.p7.4'] },
];
---

<section class="page-hero">
  <div class="wrap">
    <div class="kicker"><span>{t('services.k')}</span></div>
    <h1>{t('page.ypiresies.title')}</h1>
    <p>{t('services.lead')}</p>
  </div>
</section>

<section class="block">
  <div class="wrap">
    <div class="deck">
      {pillars.map((p) => (
        <div class="deck-card">
          <div class="dc-top"><span class="dc-no">{p.no}</span><span class="dc-t">{t(p.t)}</span></div>
          <p class="dc-d">{t(p.d)}</p>
          <ul class="dc-list">
            {p.li.map((k) => <li>{t(k)}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="cta-band solo">
  <div class="wrap">
    <div>
      <h2>{t('cta.title')}</h2>
      <p>{t('cta.lead')}</p>
      <a class="btn btn-primary" href="mailto:info@innoland.gr"><span>{t('cta.btn')}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
    </div>
  </div>
</section>
