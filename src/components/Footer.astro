---
import { useTranslations, localizedPath, withBase, type Lang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'el') as Lang;
const t = useTranslations(lang);
---

<footer>
  <div class="wrap">
    <div>
      <img src={withBase("logo-v2.png")} alt="INNOLAND" width="116" height="26" />
      <p class="co legal">
        <span>{t('foot.legal.1')}</span>
        <span>{t('foot.legal.2')}</span>
        <span>{t('foot.legal.3')}</span>
        <span>{t('foot.legal.4')}</span>
      </p>
    </div>
    <div>
      <h3>{t('foot.nav')}</h3>
      <div class="fnav">
        <a href={localizedPath(lang, 'ypiresies')}>{t('nav.services')}</a>
        <a href={localizedPath(lang, 'tomeis')}>{t('nav.sectors')}</a>
        <a href={localizedPath(lang, 'etaireia')}>{t('nav.about')}</a>
        <a href={localizedPath(lang, 'politikes')}>{t('nav.policies')}</a>
      </div>
    </div>
    <div>
      <h3>{t('foot.sectors')}</h3>
      <div class="fnav">
        <a href={localizedPath(lang, 'tomeis')}>{t('sec.1')}</a>
        <a href={localizedPath(lang, 'tomeis')}>{t('sec.3')}</a>
        <a href={localizedPath(lang, 'tomeis')}>{t('sec.5')}</a>
      </div>
    </div>
    <div>
      <h3>{t('foot.contact')}</h3>
      <p class="co">
        {t('contact.addr1')}<br />{t('contact.addr2')}<br />
        <a href="tel:+302106995053">+30 210 6995053</a><br />
        <a href="mailto:info@innoland.gr">info@innoland.gr</a><br />
        {t('contact.gemi')}
      </p>
    </div>
  </div>
  <div class="wrap foot-b">
    <span>{t('foot.rights')}</span>
    <span>{t('foot.tag')}</span>
  </div>
</footer>
