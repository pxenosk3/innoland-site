---
// Σελίδα Επικοινωνία - στοιχεία επικοινωνίας (κοινό σώμα EL/EN). Στατικός ιστότοπος, χωρίς φόρμα (ρητή σημείωση).
import { useTranslations, type Lang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'el') as Lang;
const t = useTranslations(lang);
---

<section class="page-hero">
  <div class="wrap">
    <div class="kicker"><span>{t('con.k')}</span></div>
    <h1>{t('page.epikoinonia.title')}</h1>
    <p>{t('page.epikoinonia.intro')}</p>
  </div>
</section>

<section class="block">
  <div class="wrap">
    <div class="head">
      <div class="kicker"><span>{t('con.k')}</span></div>
      <h2>{t('con.title')}</h2>
      <p>{t('con.lead')}</p>
    </div>
    <div class="cmethods">
      <div class="cmethod">
        <span class="cm-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg></span>
        <span class="cm-k">{t('con.email.k')}</span>
        <a class="cm-v" href="mailto:info@innoland.gr">{t('con.email.v')}</a>
      </div>
      <div class="cmethod">
        <span class="cm-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.6a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.9 2z"></path></svg></span>
        <span class="cm-k">{t('con.phone.k')}</span>
        <a class="cm-v" href="tel:+302106995053">{t('con.phone.v')}</a>
      </div>
      <div class="cmethod">
        <span class="cm-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></span>
        <span class="cm-k">{t('con.addr.k')}</span>
        <span class="cm-v">{t('contact.addr1')}, {t('contact.addr2')}</span>
      </div>
    </div>
    <div class="note"><span class="dot"></span><span>{t('con.note')}</span></div>
  </div>
</section>

<section class="block surface2">
  <div class="wrap">
    <div class="idlist">
      <div class="idrow"><div class="k">{t('con.legal.k')}</div><div class="v">{t('con.legal.v')}</div></div>
    </div>
  </div>
</section>

<section class="cta-band solo">
  <div class="wrap">
    <div>
      <h2>{t('cta.title')}</h2>
      <p>{t('cta.lead')}</p>
      <a class="btn btn-primary" href="mailto:info@innoland.gr"><span>{t('cta.btn')}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
    </div>
  </div>
</section>
