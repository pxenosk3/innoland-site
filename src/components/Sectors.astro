---
// Σελίδα Τομείς - 5 αλληλοσυνδεόμενοι τομείς με υποστοιχεία (κοινό σώμα EL/EN).
// Reuse sec.1..5 + sd.1..5 + νέα sct.* bullets. Εικονίδια από την αρχική (σταθερά).
import { useTranslations, type Lang, type UiKey } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'el') as Lang;
const t = useTranslations(lang);

const icons = [
  '<svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"></circle><path d="M3.5 20a5.5 5.5 0 0 1 11 0"></path><path d="M16 6.5a2.8 2.8 0 0 1 0 5.4"></path><path d="M17.5 20a5.5 5.5 0 0 0-3-4.9"></path></svg>',
  '<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="1.5"></rect><path d="M8 20h8M12 16v4"></path><path d="M7 9h4M7 12h7"></path></svg>',
  '<svg viewBox="0 0 24 24"><path d="M12 21s-6.5-5.3-6.5-10a6.5 6.5 0 0 1 13 0c0 4.7-6.5 10-6.5 10z"></path><circle cx="12" cy="11" r="2.3"></circle></svg>',
  '<svg viewBox="0 0 24 24"><path d="M12 20c6-1 8-6 8-13-6 0-11 2-11 8a5 5 0 0 0 3 5z"></path><path d="M6 20c0-4 1.5-6.5 4-8.5"></path></svg>',
  '<svg viewBox="0 0 24 24"><path d="M9 18h6M10 21h4"></path><path d="M12 3a6 6 0 0 0-3.8 10.7c.5.4.8 1 .8 1.6v.2h6v-.2c0-.6.3-1.2.8-1.6A6 6 0 0 0 12 3z"></path></svg>',
];
const sectors: { t: UiKey; d: UiKey; li: UiKey[] }[] = [
  { t: 'sec.1', d: 'sd.1', li: ['sct.1.1', 'sct.1.2', 'sct.1.3'] },
  { t: 'sec.2', d: 'sd.2', li: ['sct.2.1', 'sct.2.2', 'sct.2.3'] },
  { t: 'sec.3', d: 'sd.3', li: ['sct.3.1', 'sct.3.2', 'sct.3.3'] },
  { t: 'sec.4', d: 'sd.4', li: ['sct.4.1', 'sct.4.2', 'sct.4.3'] },
  { t: 'sec.5', d: 'sd.5', li: ['sct.5.1', 'sct.5.2', 'sct.5.3'] },
];
---

<section class="page-hero">
  <div class="wrap">
    <div class="kicker"><span>{t('sectors.k')}</span></div>
    <h1>{t('page.tomeis.title')}</h1>
    <p>{t('sectors.lead')}</p>
  </div>
</section>

<section class="block">
  <div class="wrap">
    <div class="deck">
      {sectors.map((s, i) => (
        <div class="deck-card">
          <div class="dc-top"><span class="dc-ic" set:html={icons[i]}></span><span class="dc-t">{t(s.t)}</span></div>
          <p class="dc-d">{t(s.d)}</p>
          <ul class="dc-list">
            {s.li.map((k) => <li>{t(k)}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="cta-band solo">
  <div class="wrap">
    <div>
      <h2>{t('cta.title')}</h2>
      <p>{t('cta.lead')}</p>
      <a class="btn btn-primary" href="mailto:info@innoland.gr"><span>{t('cta.btn')}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
    </div>
  </div>
</section>
