---
import { useTranslations, localeBase, altLocaleUrl, localizedPath, withBase, type Lang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'el') as Lang;
const t = useTranslations(lang);
const path = Astro.url.pathname;
const home = localeBase(lang);
const elUrl = altLocaleUrl(path, 'el');
const enUrl = altLocaleUrl(path, 'en');

const nav = [
  { slug: 'ypiresies', key: 'nav.services' },
  { slug: 'tomeis', key: 'nav.sectors' },
  { slug: 'etaireia', key: 'nav.about' },
  { slug: 'erga', key: 'nav.projects' },
  { slug: 'politikes', key: 'nav.policies' },
  { slug: 'epikoinonia', key: 'nav.contact' },
] as const;

// τρέχουσα διαδρομή χωρίς trailing slash, για ενεργό nav item
const cur = path.replace(/\/+$/, '') || '/';
---

<header>
  <div class="wrap bar">
    <a class="brand" href={home} aria-label={t('a11y.brand')}>
      <img src={withBase("logo-v2.png")} alt="INNOLAND" width="134" height="30" />
    </a>
    <nav class="main" id="nav">
      {nav.map((n) => {
        const href = localizedPath(lang, n.slug);
        const active = cur === href.replace(/\/+$/, '');
        return <a href={href} aria-current={active ? 'page' : undefined}>{t(n.key)}</a>;
      })}
    </nav>
    <div class="controls">
      <div class="seg" role="group" aria-label={t('a11y.langgroup')}>
        <a href={elUrl} hreflang="el" aria-current={lang === 'el' ? 'true' : undefined}>{t('lang.el')}</a>
        <a href={enUrl} hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>{t('lang.en')}</a>
      </div>
      <button class="icon-btn" id="theme" type="button" aria-label={t('a11y.theme')}>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button class="icon-btn menu-btn" id="menu" type="button" aria-label={t('a11y.menu')} aria-expanded="false" aria-controls="nav">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Theme toggle + mobile menu (γλώσσα = URL routing, χωρίς JS)
  (function () {
    const root = document.documentElement;
    const tbtn = document.getElementById('theme');
    if (tbtn) {
      tbtn.addEventListener('click', function () {
        let cur = root.getAttribute('data-theme');
        if (!cur) {
          cur = window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
        }
        const next = cur === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('innoland-theme', next);
        } catch (e) {}
      });
    }

    const mbtn = document.getElementById('menu');
    const nav = document.getElementById('nav');
    if (mbtn && nav) {
      mbtn.addEventListener('click', function () {
        const open = nav.classList.toggle('open');
        mbtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      nav.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          nav.classList.remove('open');
          mbtn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  })();
</script>
