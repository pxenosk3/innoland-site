---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { altLocaleUrl, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const lang = (Astro.currentLocale ?? 'el') as Lang;
const path = Astro.url.pathname;

// Canonical + hreflang alternates (absolute, από το config site).
const canonical = new URL(path, Astro.site).href;
const elHref = new URL(altLocaleUrl(path, 'el'), Astro.site).href;
const enHref = new URL(altLocaleUrl(path, 'en'), Astro.site).href;
const ogLocale = lang === 'en' ? 'en_GB' : 'el_GR';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="el" href={elHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={elHref} />
    <meta name="theme-color" content="#508090" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F191D" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="INNOLAND" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="generator" content={Astro.generator} />
    <!-- theme init: εφαρμογή αποθηκευμένου θέματος πριν το paint (αποφυγή FOUC) -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('innoland-theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
