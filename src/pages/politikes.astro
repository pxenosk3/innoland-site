---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageStub from '../components/PageStub.astro';
import { useTranslations, type Lang } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'el') as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('page.politikes.title') + ' - INNOLAND'} description={t('page.politikes.intro')}>
  <PageStub titleKey="page.politikes.title" introKey="page.politikes.intro" />
</BaseLayout>
